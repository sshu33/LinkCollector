<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".BrowserActivity">

    <!-- アドレスバー行（変更なし） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/white"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/forwardButton"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="Forward"
            tools:ignore="TouchTargetSizeCheck" />

        <EditText
            android:id="@+id/urlEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="URLを入力または検索"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/pasteUrlButton"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_paste"
            android:contentDescription="Paste URL"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/goButton"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Go"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>

    <!-- ★ お気に入りバー（新規追加） -->
    <LinearLayout
        android:id="@+id/favoritesBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- ★追加ボタン -->
        <ImageButton
            android:id="@+id/addFavoriteButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite"
            android:contentDescription="お気に入りに追加"
            app:tint="@color/button_lime"
            tools:ignore="TouchTargetSizeCheck"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <!-- 区切り線 -->
        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#CCCCCC"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- お気に入りリスト（横スクロール） -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/favoritesContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

        </HorizontalScrollView>

    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
